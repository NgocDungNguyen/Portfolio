# Copy to .env (never commit .env). Everything is read locally; nothing is sent to anyone but Cloudflare R2 and your git remote.

# Live site the "Scan live site" button reads
SITE_URL=https://ngocdungnguyen.github.io/Portfolio/

# --- Cloudflare R2 (optional but recommended for images + mp4) ---
# Cloudflare dashboard > R2 > Overview shows the account id
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create token (Object Read & Write, scoped to ONE bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-assets
# Public base URL of the bucket: the r2.dev URL or your custom domain (e.g. https://cdn.example.com). No trailing slash needed.
R2_PUBLIC_BASE=

# --- Git ---
# Branch the tool commits to and pushes. Created if missing.
GIT_BRANCH=content/media-updates

# --- Server ---
PORT=4173
